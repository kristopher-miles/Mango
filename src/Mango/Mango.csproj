<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework Condition="'$(MangoLinux)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(MangoLinux)' == 'true'">net10.0</TargetFramework>
    <OutputType Condition="'$(MangoLinux)' != 'true' and '$(MangoConsole)' != 'true'">WinExe</OutputType>
    <UseWindowsForms Condition="'$(MangoLinux)' != 'true'">true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.0.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MangoLinux)' == 'true'">
    <Compile Remove="Host/Tray.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Mango.Tests" />
    <AssemblyMetadata Include="MangoProtocolWindow" Value="1" />
    <EmbeddedResource Include="../../scripts/update-publisher.pub" LogicalName="Mango.UpdatePublisher" />
    <EmbeddedResource Include="Host/ApplyUpdate.ps1" LogicalName="Mango.ApplyUpdate" />
  </ItemGroup>
</Project>
